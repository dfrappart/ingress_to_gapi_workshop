# ListenerSet-openssl.cnf
[ req ]
default_bits       = 4096
prompt             = no
default_md         = sha256
req_extensions     = req_ext
distinguished_name = dn

[ dn ]
C  = Fr
O  = dfitc
CN = listenerset.app.teknews.cloud

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = listenerset.app.teknews.cloud
DNS.2 = listenerset
DNS.3 = app2.app.teknews.cloud